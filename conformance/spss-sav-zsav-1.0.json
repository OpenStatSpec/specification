{
  "manifest_version": "1.0",
  "profile": "OpenStatSpec SPSS SAV/ZSAV 1.0",
  "semantic_round_trip": true,
  "byte_identical_output_required": false,
  "required_capabilities": [
    "sav_read", "sav_write", "zsav_read", "zsav_write",
    "file_label", "documents", "source_encoding", "attributes",
    "variable_dictionary", "value_labels", "missing_rules",
    "lowest_highest_missing", "long_utf8_strings", "weight_variable",
    "variable_sets", "multiple_response_sets", "multiple_response_string_counted_value"
  ],
  "fixtures": [
    {
      "id": "core-numeric-string",
      "source": "fixtures/core-numeric-string.sav",
      "directions": ["import", "export", "semantic_round_trip"],
      "expects": ["case_order", "variable_order", "binary64_values", "string_values", "numeric_system_missing", "blank_string_not_missing"]
    },
    {
      "id": "dictionary-and-display",
      "source": "fixtures/dictionary-and-display.sav",
      "directions": ["import", "export", "semantic_round_trip"],
      "expects": ["file_label", "documents_order", "variable_labels", "print_write_formats", "measurement_level", "variable_role", "display_width", "display_alignment", "value_labels_typed_ordered"],
      "expected_catalog": {
        "value_labels": [
          {"variable": "gender", "ordinal": 1, "kind": "numeric", "value": 1.0, "label": "Woman"},
          {"variable": "gender", "ordinal": 2, "kind": "numeric", "value": 2.0, "label": "Man"},
          {"variable": "gender", "ordinal": 3, "kind": "numeric", "value": 9.0, "label": "Not stated"},
          {"variable": "satisfaction", "ordinal": 1, "kind": "numeric", "value": 1.0, "label": "Very dissatisfied"},
          {"variable": "satisfaction", "ordinal": 2, "kind": "numeric", "value": 2.0, "label": "Dissatisfied"},
          {"variable": "satisfaction", "ordinal": 3, "kind": "numeric", "value": 3.0, "label": "Neutral"},
          {"variable": "satisfaction", "ordinal": 4, "kind": "numeric", "value": 4.0, "label": "Satisfied"},
          {"variable": "satisfaction", "ordinal": 5, "kind": "numeric", "value": 5.0, "label": "Very satisfied"}
        ]
      }
    },
    {
      "id": "missing-rules",
      "source": "fixtures/missing-rules.sav",
      "directions": ["import", "export", "semantic_round_trip"],
      "expects": ["discrete_numeric_missing", "discrete_string_missing", "numeric_range_missing", "lowest_highest_missing", "range_plus_discrete_missing", "raw_user_missing_values"]
    },
    {
      "id": "long-utf8-and-attributes",
      "source": "fixtures/long-utf8-and-attributes.sav",
      "directions": ["import", "export", "semantic_round_trip"],
      "expects": ["utf8_source_encoding", "string_over_255_bytes", "no_string_truncation", "long_string_value_labels", "dataset_attribute_arrays", "variable_attribute_arrays"],
      "expected_catalog": {
        "dataset_attributes": [
          {"name": "$VariableView2", "values": ["name", "type", "width", "decimals", "label", "values", "missing", "columns", "alignment", "measure", "role", "@source_tags"]},
          {"name": "fixture_metadata", "values": ["OpenStatSpec", "1.0", "synthetic"]}
        ],
        "variable_attributes": [
          {"variable": "long_utf8_text", "name": "source_tags", "values": ["synthetic", "utf8", "long-string"]}
        ],
        "value_labels": [
          {"variable": "long_utf8_text", "ordinal": 1, "kind": "string", "value": "coded", "label": "Short code stored in a very-long string variable"}
        ]
      }
    },
    {
      "id": "sets",
      "source": "fixtures/sets.sav",
      "directions": ["import", "export", "semantic_round_trip"],
      "expects": ["variable_sets_ordered", "multiple_response_md", "multiple_response_mc", "multiple_response_members_ordered", "multiple_response_counted_value", "multiple_response_category_label_behavior", "multiple_response_label_source"],
      "expected_catalog": {
        "variable_sets": [
          {"ordinal": 1, "name": "demographics", "members": ["respondent_id", "age", "gender"]},
          {"ordinal": 2, "name": "contact_channels", "members": ["channel_email", "channel_sms", "channel_web", "preferred_contact_1", "preferred_contact_2"]}
        ],
        "multiple_response_sets": [
          {"ordinal": 1, "name": "$contact_modes", "kind": "MD", "label": "Contact modes (multiple)", "counted_kind": "numeric", "counted_value": 1.0, "category_labels": "variable_labels", "label_source": "set_label", "members": ["channel_email", "channel_sms", "channel_web"]},
          {"ordinal": 2, "name": "$preferred_contact", "kind": "MC", "label": "Preferred contact mode", "counted_kind": null, "counted_value": null, "category_labels": "variable_labels", "label_source": "set_label", "members": ["preferred_contact_1", "preferred_contact_2"]}
        ]
      }
    },
    {
      "id": "weight-and-string-mr",
      "source": "fixtures/weight-and-string-mr.sav",
      "directions": ["import", "export", "semantic_round_trip"],
      "expects": ["weight_variable", "multiple_response_md", "multiple_response_members_ordered", "multiple_response_counted_value", "multiple_response_string_counted_value", "multiple_response_category_label_behavior", "multiple_response_label_source"],
      "expected_catalog": {
        "weight_variable": "survey_weight",
        "multiple_response_sets": [
          {"ordinal": 1, "name": "$contact_text", "kind": "MD", "label": "Text-coded contact modes", "counted_kind": "string", "counted_value": "yes", "category_labels": "counted_values", "label_source": "variable_label", "members": ["channel_email_text", "channel_sms_text"]}
        ]
      }
    },
    {
      "id": "zsav-compressed",
      "source": "fixtures/zsav-compressed.zsav",
      "directions": ["import", "export", "semantic_round_trip"],
      "expects": ["zsav_zlib_decode", "zsav_zlib_encode", "dictionary_preserved", "values_preserved"]
    },
    {
      "id": "preflight-failure",
      "source": "fixtures/preflight-too-wide.sav",
      "directions": ["import"],
      "expects": ["atomic_failure", "no_dataset_row", "no_data_table", "operation_record", "fidelity_event_null_dataset_id", "target_capability_exceeded"]
    }
  ],
  "comparison": {
    "ignore": ["binary_file_layout", "compression_representation", "product_info", "timestamps"],
    "require": ["cases", "case_order", "variables", "variable_order", "raw_values", "system_missing", "dictionary_metadata"]
  }
}
