{
  "contract": "openstatspec-strict-wide-table-v1",
  "common": {
    "one_dataset_one_physical_table": true,
    "technical_ordinal": "__case_ordinal",
    "source_case_order": "required",
    "source_variable_order": "required",
    "numeric_system_missing": "sql_null",
    "string_system_missing": false,
    "automatic_table_splitting": false,
    "automatic_reshaping": false,
    "catalog_binding": {
      "exclusive_namespace_required": true,
      "identity_relation": "catalog_identity",
      "foreign_object_collision": "fail_without_modification",
      "exclusive_resolution_required": true
    }
  },
  "server_version_policy": {
    "reviewed_on": "2026-07-31",
    "claim_scope": "maintained_release_series",
    "ci_evidence": "exact_patch_version",
    "reference_adapter_targets": {
      "mysql": {
        "claimed_release_series": [
          "8.4.x",
          "9.7.x"
        ],
        "exact_ci_target_versions": [
          "8.4.11",
          "9.7.2"
        ],
        "latest_stable_version": "9.7.2"
      },
      "mariadb": {
        "claimed_release_series": [
          "11.4.x",
          "11.8.x",
          "12.3.x"
        ],
        "exact_ci_target_versions": [
          "11.4.12",
          "11.8.8",
          "12.3.2"
        ],
        "latest_stable_version": "12.3.2"
      },
      "postgresql": {
        "claimed_release_series": [
          "17.x",
          "18.x"
        ],
        "exact_ci_target_versions": [
          "17.10",
          "18.4"
        ],
        "latest_stable_version": "18.4"
      },
      "dolt": {
        "claimed_release_series": [
          "2.2.x"
        ],
        "minimum_inclusive": "2.2.2",
        "maximum_exclusive": "2.3.0",
        "exact_ci_target_versions": [
          "2.2.2",
          "2.2.3"
        ],
        "latest_stable_version": "2.2.3"
      }
    }
  },
  "profiles": {
    "sqlite": {
      "maximum_columns_default": 2000,
      "identifier_quoting": "double_quote",
      "identifier_limit": {
        "value": 255,
        "unit": "bytes",
        "source": "OpenStatSpec adapter policy; SQLite has no separate engine identifier-length setting",
        "repertoire": "ASCII-safe generated physical identifiers"
      },
      "catalog_namespace_modes": [
        "dedicated_database",
        "attached_database",
        "reserved_prefix"
      ],
      "numeric_type": "REAL",
      "string_type": "TEXT NOT NULL",
      "case_ordinal_type": "INTEGER NOT NULL PRIMARY KEY",
      "transactional_ddl": true,
      "effective_limits_must_be_published": [
        "maximum_columns",
        "maximum_value_bytes",
        "maximum_row_bytes"
      ]
    },
    "postgresql": {
      "maximum_columns_default": 1600,
      "identifier_quoting": "double_quote",
      "identifier_limit": {
        "value": 63,
        "unit": "bytes",
        "source": "active max_identifier_length; default NAMEDATALEN minus one",
        "repertoire": "active PostgreSQL server encoding"
      },
      "catalog_namespace_modes": [
        "schema"
      ],
      "numeric_type": "DOUBLE PRECISION",
      "string_type": "TEXT NOT NULL",
      "case_ordinal_type": "BIGINT NOT NULL PRIMARY KEY",
      "transactional_ddl": true,
      "effective_limits_must_be_published": [
        "maximum_columns",
        "maximum_value_bytes",
        "maximum_row_bytes"
      ]
    },
    "mysql_mariadb_innodb": {
      "maximum_columns_default": 1017,
      "identifier_quoting": "backtick",
      "identifier_limit": {
        "value": 64,
        "unit": "characters",
        "source": "MySQL/MariaDB schema-object identifier limit",
        "repertoire": "Unicode Basic Multilingual Plane; U+0000 excluded"
      },
      "catalog_namespace_modes": [
        "database"
      ],
      "numeric_type": "DOUBLE",
      "string_type": "TEXT NOT NULL or preflighted lossless VARCHAR(n)",
      "case_ordinal_type": "BIGINT NOT NULL PRIMARY KEY",
      "transactional_ddl": false,
      "effective_limits_must_be_published": [
        "maximum_columns",
        "maximum_value_bytes",
        "maximum_row_bytes"
      ],
      "failure_cleanup_required": true
    },
    "dolt": {
      "engine": "dolt",
      "transport": "mysql_compatible",
      "identity": {
        "required_probes": [
          "@@version",
          "@@version_comment",
          "DOLT_VERSION()"
        ],
        "version_comment_normalized_equals": "dolt",
        "signals_must_be_mutually_consistent": true,
        "failure_policy": "fail_before_catalog_or_dataset_mutation"
      },
      "claimed_version_range": {
        "minimum_inclusive": "2.2.2",
        "maximum_exclusive": "2.3.0"
      },
      "exact_ci_tested_versions": [
        "2.2.2",
        "2.2.3"
      ],
      "maximum_columns_default": 306,
      "maximum_source_variables_default": 305,
      "identifier_quoting": "backtick",
      "identifier_limit": {
        "value": 64,
        "unit": "bytes",
        "source": "pinned live Dolt 2.2.2: 64-byte ASCII identifier succeeded and 65-byte identifier was rejected",
        "repertoire": "ASCII-safe generated physical identifiers"
      },
      "catalog_namespace_modes": [
        "database"
      ],
      "catalog_binding_policy": "dedicated_database",
      "numeric_type": "DOUBLE",
      "string_type": "LONGTEXT NOT NULL",
      "case_ordinal_type": "BIGINT NOT NULL PRIMARY KEY",
      "maximum_row_bytes_default": 65504,
      "limit_evidence": {
        "maximum_physical_columns": {
          "value": 306,
          "unit": "columns",
          "classification": "proposed_adapter_envelope",
          "source": "306 and 307 physical columns both succeeded on pinned live Dolt 2.2.2; 306 including __case_ordinal is the conservative adapter envelope, not a native maximum"
        },
        "maximum_source_variables": {
          "value": 305,
          "unit": "variables",
          "classification": "proposed_adapter_envelope",
          "source": "derived from the conservative 306-physical-column adapter envelope with one column reserved for __case_ordinal"
        },
        "identifier_length": {
          "value": 64,
          "unit": "bytes",
          "classification": "observed_exact_version",
          "source": "64-byte ASCII identifier succeeded and 65-byte identifier was rejected on pinned live Dolt 2.2.2"
        },
        "maximum_row_size": {
          "value": 65504,
          "unit": "bytes",
          "classification": "proposed_adapter_envelope",
          "source": "conservative row preflight ceiling supported by an observed 65,504-byte UTF-8 LONGTEXT value round trip on pinned live Dolt 2.2.2; no native row-size maximum is claimed"
        }
      },
      "storage_evidence": {
        "binary64": {
          "type": "DOUBLE",
          "classification": "observed_exact_version",
          "source": "maximum finite binary64 round-tripped exactly on pinned live Dolt 2.2.2"
        },
        "text": {
          "type": "LONGTEXT NOT NULL",
          "observed_value_bytes": 65504,
          "classification": "observed_exact_version",
          "source": "65,504 UTF-8 bytes round-tripped exactly on pinned live Dolt 2.2.2"
        }
      },
      "transactional_ddl": false,
      "failure_cleanup_required": true,
      "effective_limits_must_be_published": [
        "maximum_physical_columns",
        "maximum_source_variables",
        "maximum_identifier_bytes",
        "maximum_value_bytes",
        "maximum_row_bytes",
        "maximum_statement_bytes"
      ],
      "transformation_workflow": "unsupported"
    }
  }
}
